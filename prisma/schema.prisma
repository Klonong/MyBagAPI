generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                               String            @unique @db.VarChar(255)
  passwordHash                        String            @map("password_hash") @db.VarChar(255)
  name                                String?           @db.VarChar(255)
  phone                               String?           @db.VarChar(255)
  avatar_url                          String?           @db.VarChar(1000)
  bio                                 String?           @db.VarChar(1000)
  location                            String?           @db.VarChar(255)
  role                                String            @default("user") @db.VarChar(50)
  is_active                           Boolean           @default(true)
  createdAt                           DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  addresses                           addresses[]
  carts                               carts?
  orders                              orders[]
  products_products_created_byTousers products[]        @relation("products_created_byTousers")
  products_products_updated_byTousers products[]        @relation("products_updated_byTousers")
  wishlist_items                      wishlist_items[]
  sessions                            sessions[]
  product_reviews                     product_reviews[]

  @@map("users")
}

model order_statuses {
  id         Int      @id @default(autoincrement())
  code       String   @unique @db.VarChar(50)
  name       String   @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamp(6)
  orders     orders[]
}

model discounts {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @db.VarChar(255)
  code       String   @unique @db.VarChar(100)
  type       String   @db.VarChar(20)
  value      Decimal  @db.Decimal(15, 2)
  starts_at  DateTime @db.Timestamp(6)
  ends_at    DateTime @db.Timestamp(6)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)

  @@index([is_active], map: "idx_discounts_is_active")
  @@index([starts_at, ends_at], map: "idx_discounts_dates")
}

model store_settings {
  id            Int      @id @default(1)
  store_name    String   @default("Pioma") @db.VarChar(255)
  support_email String?  @db.VarChar(255)
  currency      String   @default("IDR") @db.VarChar(10)
  updated_at    DateTime @updatedAt @db.Timestamp(6)
}

model shipping_methods {
  id         Int      @id @default(autoincrement())
  code       String   @unique @db.VarChar(50)
  name       String   @db.VarChar(100)
  fee        Decimal  @db.Decimal(15, 2)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
  orders     orders[]
}

model addresses {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @db.Uuid
  label          String?  @db.VarChar(100)
  recipient_name String   @db.VarChar(255)
  phone          String   @db.VarChar(255)
  address_line   String   @db.VarChar(500)
  address_line2  String?  @db.VarChar(500)
  city           String   @db.VarChar(255)
  province       String   @db.VarChar(255)
  postal_code    String   @db.VarChar(20)
  country        String   @default("Indonesia") @db.VarChar(100)
  is_default     Boolean  @default(false)
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @default(now()) @db.Timestamp(6)
  users          User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders         orders[]

  @@index([user_id], map: "idx_addresses_user_id")
}

model badges {
  id       BigInt     @id @default(autoincrement())
  name     String     @unique @db.VarChar(255)
  products products[]
}

model sessions {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  ip           String?   @db.VarChar(100)
  user_agent   String?   @db.VarChar(500)
  created_at   DateTime  @default(now()) @db.Timestamp(6)
  last_seen_at DateTime  @default(now()) @db.Timestamp(6)
  revoked_at   DateTime? @db.Timestamp(6)
  users        User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_sessions_user_id")
}

model product_reviews {
  id         BigInt   @id @default(autoincrement())
  product_id String   @db.Uuid
  user_id    String   @db.Uuid
  rating     Int
  comment    String?
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, product_id])
  @@index([product_id], map: "idx_product_reviews_product_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cart_items {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cart_id        String          @db.Uuid
  product_id     String          @db.Uuid
  color_id       BigInt?
  quantity       Int             @default(1)
  created_at     DateTime        @default(now()) @db.Timestamp(6)
  carts          carts           @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_colors product_colors? @relation(fields: [color_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products       products        @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cart_id, product_id, color_id])
  @@index([cart_id], map: "idx_cart_items_cart_id")
}

model carts {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String       @unique @db.Uuid
  created_at DateTime     @default(now()) @db.Timestamp(6)
  updated_at DateTime     @default(now()) @db.Timestamp(6)
  cart_items cart_items[]
  users      User         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model categories {
  id         BigInt     @id @default(autoincrement())
  name       String     @unique @db.VarChar(255)
  updated_at DateTime   @default(now()) @updatedAt @db.Timestamp(6)
  products   products[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id       String          @db.Uuid
  product_id     String          @db.Uuid
  color_id       BigInt?
  product_name   String          @db.VarChar(255)
  color_name     String?         @db.VarChar(255)
  unit_price     Decimal         @db.Decimal(15, 2)
  quantity       Int
  subtotal       Decimal         @db.Decimal(15, 2)
  product_colors product_colors? @relation(fields: [color_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders         orders          @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products       products        @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([order_id], map: "idx_order_items_order_id")
}

model orders {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String            @db.Uuid
  address_id         String?           @db.Uuid
  status_id          Int               @default(1)
  shipping_method_id Int?
  delivery_method    String            @default("standard") @db.VarChar(50)
  payment_method     String            @default("card") @db.VarChar(50)
  subtotal           Decimal           @db.Decimal(15, 2)
  shipping_fee       Decimal           @default(0) @db.Decimal(15, 2)
  tax                Decimal           @default(0) @db.Decimal(15, 2)
  discount           Decimal           @default(0) @db.Decimal(15, 2)
  total              Decimal           @db.Decimal(15, 2)
  created_at         DateTime          @default(now()) @db.Timestamp(6)
  updated_at         DateTime          @default(now()) @db.Timestamp(6)
  order_items        order_items[]
  order_statuses     order_statuses    @relation(fields: [status_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shipping_methods   shipping_methods? @relation(fields: [shipping_method_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  addresses          addresses?        @relation(fields: [address_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users              User              @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "idx_orders_user_id")
  @@index([shipping_method_id], map: "idx_orders_shipping_method_id")
}

model product_color_images {
  id             BigInt         @id @default(autoincrement())
  color_id       BigInt
  image_url      String         @db.VarChar(1000)
  product_colors product_colors @relation(fields: [color_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([color_id], map: "idx_product_color_images_color_id")
}

model product_colors {
  id                   BigInt                 @id @default(autoincrement())
  product_id           String                 @db.Uuid
  name                 String?                @db.VarChar(255)
  hex_code             String?                @db.VarChar(20)
  stock                BigInt                 @default(0)
  cart_items           cart_items[]
  order_items          order_items[]
  product_color_images product_color_images[]
  products             products               @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_product_colors_product_id")
}

model product_images {
  id         BigInt   @id @default(autoincrement())
  product_id String   @db.Uuid
  image_url  String   @db.VarChar(1000)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id], map: "idx_product_images_product_id")
}

model products {
  id                               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                             String            @db.VarChar(255)
  description                      String?
  price                            Decimal           @db.Decimal(15, 2)
  discount                         Decimal?          @db.Decimal(15, 2)
  category_id                      BigInt
  badge_id                         BigInt?
  created_by                       String?           @db.Uuid
  updated_by                       String?           @db.Uuid
  created_at                       DateTime          @default(now()) @db.Timestamp(6)
  updated_at                       DateTime          @default(now()) @db.Timestamp(6)
  cart_items                       cart_items[]
  order_items                      order_items[]
  product_colors                   product_colors[]
  product_images                   product_images[]
  badges                           badges?           @relation(fields: [badge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categories                       categories        @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_products_created_byTousers User?             @relation("products_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_products_updated_byTousers User?             @relation("products_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wishlist_items                   wishlist_items[]
  product_reviews                  product_reviews[]

  @@index([badge_id], map: "idx_products_badge_id")
  @@index([category_id], map: "idx_products_category_id")
}

model wishlist_items {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  product_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamp(6)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, product_id])
  @@index([user_id], map: "idx_wishlist_items_user_id")
}
