        {
          "name": "Delete Badge",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/badges/:id", "host": ["{{baseUrl}}"], "path": ["badges", ":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?page={{page}}&limit={{limit}}&sort={{sort}}",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "{{page}}" },
                { "key": "limit", "value": "{{limit}}" },
                { "key": "categoryId", "value": "{{categoryId}}", "disabled": true },
                { "key": "color", "value": "{{color}}", "disabled": true },
                { "key": "minPrice", "value": "{{minPrice}}", "disabled": true },
                { "key": "maxPrice", "value": "{{maxPrice}}", "disabled": true },
                { "key": "search", "value": "{{search}}", "disabled": true },
                { "key": "sort", "value": "newest" }
              ]
            }
          }
        },
        {
          "name": "Filter Products Example",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/products?page={{page}}&limit={{limit}}&categoryId={{categoryId}}&color={{color}}&minPrice={{minPrice}}&maxPrice={{maxPrice}}&search={{search}}&sort={{sort}}",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "{{page}}" },
                { "key": "limit", "value": "{{limit}}" },
                { "key": "categoryId", "value": "{{categoryId}}" },
                { "key": "color", "value": "{{color}}" },
                { "key": "minPrice", "value": "{{minPrice}}" },
                { "key": "maxPrice", "value": "{{maxPrice}}" },
                { "key": "search", "value": "{{search}}" },
                { "key": "sort", "value": "{{sort}}" }
              ]
            }
          }
        },
        {
          "name": "Get Product",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/products/:id", "host": ["{{baseUrl}}"], "path": ["products", ":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"T-Shirt\",\n  \"description\": \"Cotton t-shirt\",\n  \"price\": 100000,\n  \"discount\": 0,\n  \"categoryId\": 1,\n  \"badgeId\": 1,\n  \"productImageUrls\": [\"https://example.com/image1.jpg\"],\n  \"colors\": [\n    {\n      \"name\": \"Red\",\n      \"hexCode\": \"#FF0000\",\n      \"stock\": 10,\n      \"imageUrls\": [\"https://example.com/red.jpg\"]\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 120000\n}"
            },
            "url": { "raw": "{{baseUrl}}/products/:id", "host": ["{{baseUrl}}"], "path": ["products", ":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/products/:id", "host": ["{{baseUrl}}"], "path": ["products", ":id"], "variable": [{ "key": "id", "value": "" }] }
          }
        }
      ]
    },
